{
  "name": "freezer-inventory",
  "version": "1.0.0",
  "description": "A mobile-first freezer inventory tracker with QR code labels",
  "main": "server-dist/index.js",
  "scripts": {
    "build": "node scripts/build.js",
    "build:server": "node scripts/build.js --server && tsc --project tsconfig.server.json",
    "dev": "ts-node server/index.ts",
    "start": "node server-dist/index.js",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --project tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/qrcode": "^1.5.5",
    "esbuild": "^0.20.0",
    "qrcode": "^1.5.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
