{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "lib": ["ES2020"],
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": "server-dist",
    "rootDir": "server",
    "esModuleInterop": true
  },
  "include": ["server/**/*"]
}
